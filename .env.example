# База данных PostgreSQL
DATABASE_URL=postgresql://user:pass@localhost:5432/resume_db

# JWT авторизация
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ML-модель
MODEL_PATH=ml/models/finetuned_model

# Пути к файловым хранилищам
FILES_RESUMES_PATH=files/resumes
FILES_MODELS_PATH=files/models
FILES_REPORTS_PATH=files/reports

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
